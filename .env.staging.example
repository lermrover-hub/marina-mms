NEXT_PUBLIC_SUPABASE_URL=https://zanlunbgupdtqznruzok.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inphbmx1bmJndXBkdHF6bnJ1em9rIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA1ODUxNjYsImV4cCI6MjA5NjE2MTE2Nn0.8xUqLV27a0-uh431-QudeiVKxqiNO2t4SLhXV_xwPQM
SUPABASE_SERVICE_ROLE_KEY=get-from-supabase-dashboard-settings-api

# Agent key — local test value only, never reuse production key
MARINA_AGENT_API_KEY=local-test-key

# ── Production safety flags ───────────────────────────────────────────────────
# All flags FAIL CLOSED. Only the exact string "true" enables a capability.
# Missing / empty / "false" all block. Do NOT enable any of these on staging.
#
# Pilot safe-mode values (copy as-is for staging):
AI_AGENT_DRY_RUN=true                    # Agent skips all writes; simulates responses
ENABLE_AI_AGENT_WRITES=false             # Middleware blocks non-GET agent routes
ENABLE_REAL_CUSTOMER_MESSAGES=false      # Blocks email / LINE / WhatsApp delivery
ENABLE_PRODUCTION_BOOKINGS=false         # Blocks ramp-booking create and update
ENABLE_AUTOMATION_WRITES=false           # Blocks recurring billing DB writes

# Auth — use any random string for local testing
AUTH_SECRET=local-staging-auth-secret-change-me
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3004

# Messaging credentials MUST be absent to block sends during tests
# Do NOT set: RESEND_API_KEY, LINE_CHANNEL_ACCESS_TOKEN,
#             WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_ACCESS_TOKEN
