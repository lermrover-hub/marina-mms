{
  "name": "marina-mms-ai-agents",
  "version": "0.1.0",
  "description": "Autonomous AI agent team for Marina MMS — calls REST APIs, never modifies web app",
  "private": true,
  "type": "module",
  "scripts": {
    "run": "node run.js",
    "server": "node server.js",
    "quotation": "node run.js --agent=quotation",
    "marina": "node run.js --agent=marina",
    "finance": "node run.js --agent=finance",
    "comms": "node run.js --agent=comms",
    "hr": "node run.js --agent=hr",
    "tide": "node run.js --agent=tide",
    "test": "node --test tests/*.test.js",
    "test:live": "node --env-file=.env.test.live --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "dry-run": "node -e \"process.env.AI_AGENT_SKIP_CLAUDE='true';process.env.AI_AGENT_DRY_RUN='true';import('./run.js')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "pg": "^8.21.0"
  }
}
